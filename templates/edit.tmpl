{{define "content"}}
	<form class="recipe-form" action="{{.SubmitURL}}" method="post">
		<div class="single-item-groups">
			<div class="form-group">
				<label for="recipe-name">Recipe Name:</label>
				<input type="text" id="recipe-name" name="recipe-name" value="{{.RecipeName}}" required>
			</div>
			<div class="form-group">
				<label for="author">Author:</label>
				<input type="text" id="author" name="author" value="{{.Author}}" required>
			</div>
			<div></div>
			<div class="form-group">
				<label for="prep-time">Prep time:  <span class="form-error-message">Error format: 00h 00m</span></label>
				<input type="text" id="prep-time" name="prep-time" value="{{.PrepTime}}" pattern=" *(\d+h)? *(\d+m)? *">
			</div>
			<div class="form-group">
				<label for="total-time">Total time:  <span class="form-error-message">Error format: 00h 00m</span></label>
				<input type="text" id="total-time" name="total-time" value="{{.TotalTime}}" pattern=" *(\d+h)? *(\d+m)? *">
			</div>
			<div class="form-group">
				<label for="yield">Yield:</label>
				<input type="text" id="yield" name="yield" value="{{.Yield}}" required>
			</div>
		</div>
		<p>For the ingredients and steps, add new sections by starting a line with "## " followed by the section name</p>
		<div class="textarea-and-preview">
			<div class="textarea-group">
				<label for="ingredients">Ingredients:</label>
				<textarea class="ingredient-area" id="ingredients" name="ingredients" required placeholder="This is an ingredient
## This is a section
This is an ingredient below the above section">{{.Ingredients}}</textarea>
			</div>
			<div class="textarea-group">
				<label for="formatted-ingredients">Preview of Formatting:</label>
				<p class="ingredient-area ingredient-area-preview" id="formatted-ingredients">{{.Ingredients}}</p>
			</div>
		</div>
		<script type="text/javascript" src="/assets/js/ingredient-area-validation.js"></script>
		</div>
		<div class="textarea-group">
			<label for="steps">Steps:</label>
			<textarea class="steps-area" id="steps" name="steps" required placeholder="This is a step paragraph
## This is a section
This is a paragraph below the above section">{{.Steps}}</textarea>
		</div>
		<input type="submit" value="Submit">
	</form>
{{end}}
